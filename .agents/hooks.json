        "command": "./scripts/pep_pre_tool_use",
        "timeout_ms": 5000,
        "on_failure": "DENY_TOOL_CALL",
        "invariants": [
          "I-01",
          "I-02",
          "I-05",
          "I-08",
          "I-12",
          "I-14"
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "pep.post_tool_use.redaction",
        "matcher": "*",
        "command": "./scripts/pep_post_tool_use",
        "timeout_ms": 5000,
        "on_failure": "QUARANTINE_OUTPUT",
